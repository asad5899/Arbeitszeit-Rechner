    color: '#14b8a6', gradient: 'linear-gradient(135deg, #14b8a6 0%, #0f766e 100%)'
  },
  'resturlaub-rechner': {
    icon: `<svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8 40l8-8 6 4 8-12 10 8" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/><circle cx="36" cy="12" r="6" stroke="currentColor" stroke-width="2.5"/><path d="M36 10v4M34 12h4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>`,
