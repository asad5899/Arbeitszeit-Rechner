// Fallback default list if slug is not matched
const defaultRelevantSlugs = [
  'arbeitszeit-rechner',
  'stundenlohn-rechner',
  'arbeitsstunden-rechner',
  'ueberstunden-rechner',
];

const targetSlugs = (relevantToolsMap[currentSlug] || defaultRelevantSlugs)
  .filter(slug => slug !== currentSlug)
  .slice(0, 4);

// Tool icon & style definitions
