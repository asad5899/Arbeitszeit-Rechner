---
import { getLocaleFromUrl, defaultLocale } from '../utils/i18n';
import { getLocalizedTool } from '../data/tools';

interface Props {
  currentSlug: string;
}

const { currentSlug } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const localePath = locale === defaultLocale ? '' : `/${locale}`;

// Mapping of 4 relevant tools for each tool slug
const relevantToolsMap: Record<string, string[]> = {
  'arbeitszeit-rechner': [
    'arbeitsstunden-rechner',
    'ueberstunden-rechner',
    'stunden-und-minuten-rechner',
    'feierabend-rechner',
  ],
  'stundenlohn-rechner': [
    'arbeitszeit-rechner',
    'teilzeit-rechner',
    'schichtzulagen-rechner',
    'monatsstunden-rechner',
  ],
  'arbeitsstunden-rechner': [
    'arbeitszeit-rechner',
    'arbeitsstundenrechner',
    'wochenarbeitszeit-rechner',
    'zeiterfassung-rechner',
  ],
  'teilzeit-rechner': [
    'stundenlohn-rechner',
    'wochenstunden-rechner',
    'urlaubstage-rechner',
    'arbeitszeit-rechner',
  ],
