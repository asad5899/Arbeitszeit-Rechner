const displayedTools = targetSlugs.map(slug => {
  const tool = getLocalizedTool(slug, locale);
  const meta = toolMeta[slug] || {
    icon: `<svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="24" cy="24" r="20" stroke="currentColor" stroke-width="2.5"/></svg>`,
    color: '#3b82f6',
    gradient: 'linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%)'
  };
  return {
    ...tool,
    meta,
  };
});

// Localized headings
const showcaseBadge = locale === 'de'
  ? 'Empfohlene Rechner'
  : locale === 'fr'
  ? 'Outils Recommandés'
  : locale === 'ar'
  ? 'أدوات موصى بها'
  : 'Recommended Tools';

const showcaseTitle = locale === 'de'
  ? 'Passende Tools & Rechner'
  : locale === 'fr'
  ? 'Outils et Calculateurs Associés'
  : locale === 'ar'
  ? 'أدوات وحاسبات ذات صلة'
  : 'Related Tools & Calculators';

const showcaseSubtitle = locale === 'de'
  ? 'Entdecke 4 weitere nützliche Rechner für deine Arbeitszeit-, Überstunden- und Gehaltsabrechnung.'
  : locale === 'fr'
  ? 'Découvrez 4 calculateurs pratiques pour votre temps de travail et rémunération.'
  : locale === 'ar'
  ? 'اكتشف 4 حاسبات مفيدة أخرى لساعات العمل وحساب الأجور.'
  : 'Explore 4 more useful calculators for your working hours, overtime, and salary calculations.';
---

<section class="tools-showcase-section" id="tools-showcase" aria-labelledby="tools-showcase-heading">
  <div class="tools-showcase-container">
    <div class="tools-showcase-header">
      <span class="tools-showcase-badge">{showcaseBadge}</span>
      <h2 id="tools-showcase-heading" class="tools-showcase-title">{showcaseTitle}</h2>
      <p class="tools-showcase-subtitle">{showcaseSubtitle}</p>
    </div>

    <div class="tools-showcase-grid">
      {displayedTools.map((tool) => (
        <a 
          href={`${localePath}/tools/${tool.slug}/`} 
          class="tools-showcase-card" 
          style={`--tool-color: ${tool.meta.color}; --tool-gradient: ${tool.meta.gradient};`}
          title={tool.name}
        >
          <div class="tools-showcase-top">
            <div class="tools-showcase-icon" set:html={tool.meta.icon} />
            <div class="tools-showcase-arrow" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </div>
          </div>
          <div class="tools-showcase-body">
            <h3 class="tools-showcase-name">{tool.name}</h3>
            <p class="tools-showcase-desc">{tool.subtitle}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .tools-showcase-section {
    padding: var(--sp-12) var(--sp-6);
    background: linear-gradient(180deg, var(--gray-50) 0%, var(--white) 100%);
    border-top: 1px solid var(--gray-200);
    border-bottom: 1px solid var(--gray-200);
    margin: var(--sp-8) 0;
  }

  .tools-showcase-container {
    max-width: var(--max-w);
    margin: 0 auto;
  }

  .tools-showcase-header {
    text-align: center;
    margin-bottom: var(--sp-8);
  }

  .tools-showcase-badge {
    display: inline-block;
    padding: var(--sp-1) var(--sp-4);
    background: var(--blue-100);
    color: var(--blue-800);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: var(--sp-2);
  }

  .tools-showcase-title {
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--gray-900);
    margin: 0 0 var(--sp-2) 0;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  .tools-showcase-subtitle {
    font-size: var(--text-sm);
    color: var(--gray-600);
    margin: 0;
    max-width: 580px;
    margin-inline: auto;
    line-height: 1.5;
  }

  /* 4-Column Grid */
  .tools-showcase-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--sp-4);
  }

  /* Card */
  .tools-showcase-card {
    display: flex;
    flex-direction: column;
    padding: var(--sp-5);
    background: var(--white);
    border: 1px solid var(--gray-200);
    border-radius: var(--radius-xl);
    text-decoration: none;
    color: inherit;
