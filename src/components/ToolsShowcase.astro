    'arbeitszeiterfassung-rechner',
    'arbeitszeit-rechner',
    'arbeitsstunden-rechner',
    'gleitzeit-rechner',
  ],
  'feiertagszuschlag-rechner': [
    'sonntagszuschlag-rechner',
    'nachtzuschlag-rechner',
    'schichtzulagen-rechner',
    'stundenlohn-rechner',
  ],
