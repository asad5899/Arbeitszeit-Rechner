  ],
  'gleitzeit-rechner': [
    'ueberstunden-rechner',
    'feierabend-rechner',
    'arbeitszeiterfassung-rechner',
    'arbeitszeit-rechner',
  ],
  'monatsstunden-rechner': [
    'wochenarbeitszeit-rechner',
    'wochenstunden-rechner',
    'stundenlohn-rechner',
    'teilzeit-rechner',
  ],
  'resturlaub-rechner': [
    'urlaubstage-rechner',
    'urlaubsgeld-rechner',
    'teilzeit-rechner',
    'arbeitszeit-rechner',
  ],
  'arbeitszeiterfassung-rechner': [
    'zeiterfassung-rechner',
    'arbeitszeit-rechner',
    'arbeitsstunden-rechner',
    'gleitzeit-rechner',
