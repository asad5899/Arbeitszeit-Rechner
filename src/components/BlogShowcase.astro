---
import { getCollection } from 'astro:content';
import { getLocaleFromUrl, useTranslations, getLocalizedPath } from '../utils/i18n';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

// Get blog posts matching current locale, or fallback to all active posts
let allPosts = await getCollection('blog', ({ data }) => !data.draft);
let posts = allPosts.filter(p => p.data.locale === locale);
if (posts.length === 0) {
  posts = allPosts;
}

// Sort by date descending and get the top 3 relevant articles
posts.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());
const relevantPosts = posts.slice(0, 3);

// Localized strings
const sectionBadge = locale === 'de' ? 'Fachbeiträge & Ratgeber'
  : locale === 'fr' ? 'Guides & Articles'
  : locale === 'ar' ? 'أدلة ومقالات متخصصة'
  : 'Articles & Guides';

const sectionTitle = locale === 'de' ? 'Aktuelle Fachbeiträge & Ratgeber'
  : locale === 'fr' ? 'Guides pratiques & Conseils d\'experts'
  : locale === 'ar' ? 'أحدث المقالات والإرشادات المهنية'
  : 'Latest Articles & Practical Guides';

const sectionSubtitle = locale === 'de' ? 'Praxisnahes Wissen zu Arbeitszeitrecht, Pausenregelungen, Überstunden und moderner Zeiterfassung.'
  : locale === 'fr' ? 'Conseils clairs sur le droit du travail, la gestion des pauses, les heures supplémentaires et le suivi du temps.'
  : locale === 'ar' ? 'معلومات موثوقة حول قوانين العمل، فترات الراحة، حساب الساعات الإضافية، وإدارة أوقات الدوام.'
  : 'Practical insights on labor laws, break regulations, overtime calculations, and time tracking.';

const readMoreText = t('blog.readMore') || (
  locale === 'de' ? 'Artikel lesen'
  : locale === 'fr' ? 'Lire l\'article'
  : locale === 'ar' ? 'اقرأ المقال'
  : 'Read Article'
);

const viewAllText = locale === 'de' ? 'Alle Ratgeber anzeigen'
  : locale === 'fr' ? 'Voir tous les guides'
  : locale === 'ar' ? 'عرض جميع المقالات'
  : 'View all articles';
---

<section class="blog-showcase-section" id="fachbeitraege" aria-labelledby="blog-showcase-heading">
  <div class="blog-showcase-container">
    <div class="blog-showcase-header">
      <div>
        <span class="blog-showcase-badge">{sectionBadge}</span>
        <h2 class="blog-showcase-title" id="blog-showcase-heading">{sectionTitle}</h2>
        <p class="blog-showcase-subtitle">{sectionSubtitle}</p>
      </div>
      <a href={getLocalizedPath('/blog', locale)} class="blog-showcase-viewall">
        <span>{viewAllText}</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>

    <div class="blog-showcase-grid">
      {relevantPosts.map((post) => {
        const postUrl = getLocalizedPath(`/blog/${post.id}`, locale);
        const formattedDate = post.data.publishDate.toLocaleDateString(locale, {
          year: 'numeric',
          month: 'short',
          day: 'numeric'
        });

        return (
          <article class="blog-showcase-card">
            {post.data.image && (
              <a href={postUrl} class="blog-showcase-img-link" tabindex="-1" aria-hidden="true">
                <img
                  src={post.data.image}
                  alt={post.data.imageAlt || post.data.title}
                  loading="lazy"
                  decoding="async"
                  class="blog-showcase-img"
                />
                <span class="blog-showcase-category-tag">{post.data.category}</span>
              </a>
            )}

            <div class="blog-showcase-content">
              <div class="blog-showcase-meta">
                <span class="meta-date">{formattedDate}</span>
                <span class="meta-dot">&bull;</span>
                <span class="meta-reading">{post.data.readingTime || '5 Min.'}</span>
              </div>

              <h3 class="blog-showcase-card-title">
                <a href={postUrl}>
                  {post.data.title}
                </a>
              </h3>

              <p class="blog-showcase-card-desc">
                {post.data.description}
              </p>

              <div class="blog-showcase-card-footer">
                <a
                  href={postUrl}
                  class="blog-showcase-btn"
                  aria-label={`${post.data.title} - ${readMoreText}`}
                >
                  <span>{readMoreText}</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h14M12 5l7 7-7 7"/>
                  </svg>
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <!-- Mobile view all button -->
    <div class="blog-showcase-mobile-cta">
      <a href={getLocalizedPath('/blog', locale)} class="blog-showcase-btn-secondary">
        <span>{viewAllText}</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .blog-showcase-section {
    padding: var(--sp-16) var(--sp-6);
    background: var(--white);
    border-top: 1px solid var(--gray-300);
  }

  .blog-showcase-container {
    max-width: var(--max-w);
    margin: 0 auto;
  }

  .blog-showcase-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--sp-6);
    margin-bottom: var(--sp-10);
  }

  .blog-showcase-badge {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--blue-700);
    background: var(--blue-100);
    padding: var(--sp-1) var(--sp-3);
    border-radius: var(--radius-full);
    margin-bottom: var(--sp-3);
  }

  .blog-showcase-title {
    font-size: var(--text-3xl);
    font-weight: 800;
    color: var(--gray-900);
    letter-spacing: -0.02em;
    margin: 0 0 var(--sp-2) 0;
    line-height: 1.25;
  }

  .blog-showcase-subtitle {
    font-size: var(--text-base);
    color: var(--gray-600);
    margin: 0;
    max-width: 620px;
    line-height: 1.6;
  }

  .blog-showcase-viewall {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--blue-600);
    text-decoration: none;
    padding: var(--sp-2) var(--sp-4);
    border-radius: var(--radius-md);
    background: var(--blue-50);
    border: 1px solid var(--blue-200);
    transition: all var(--dur) var(--ease);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .blog-showcase-viewall:hover {
    background: var(--blue-600);
    color: var(--white);
    border-color: var(--blue-600);
    text-decoration: none;
    transform: translateY(-1px);
    box-shadow: var(--shadow-sm);
  }

  .blog-showcase-viewall svg {
    transition: transform var(--dur) var(--ease);
  }

  .blog-showcase-viewall:hover svg {
    transform: translateX(3px);
  }

  :global(html[dir="rtl"]) .blog-showcase-viewall:hover svg,
  :global(html[dir="rtl"]) .blog-showcase-btn:hover svg {
    transform: translateX(-3px) scaleX(-1);
  }

  :global(html[dir="rtl"]) .blog-showcase-viewall svg,
  :global(html[dir="rtl"]) .blog-showcase-btn svg,
  :global(html[dir="rtl"]) .blog-showcase-btn-secondary svg {
    transform: scaleX(-1);
  }

  .blog-showcase-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-6);
  }

  .blog-showcase-card {
    background: var(--white);
    border: 1.5px solid var(--gray-200);
    border-radius: var(--radius-xl);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: all var(--dur-slow) var(--ease);
    box-shadow: var(--shadow-xs);
  }

  .blog-showcase-card:hover {
    border-color: var(--blue-300);
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .blog-showcase-img-link {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--gray-100);
  }

  .blog-showcase-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s var(--ease);
  }

  .blog-showcase-card:hover .blog-showcase-img {
    transform: scale(1.05);
  }

  .blog-showcase-category-tag {
    position: absolute;
    top: var(--sp-3);
    inset-inline-start: var(--sp-3);
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(4px);
    color: var(--white);
    font-size: var(--text-xs);
    font-weight: 600;
    padding: 3px var(--sp-2);
    border-radius: var(--radius-sm);
    letter-spacing: 0.02em;
    pointer-events: none;
  }

  .blog-showcase-content {
    padding: var(--sp-5);
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .blog-showcase-meta {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    font-size: var(--text-xs);
    color: var(--gray-500);
    font-weight: 500;
    margin-bottom: var(--sp-2);
  }

  .meta-dot {
    color: var(--gray-400);
  }

  .blog-showcase-card-title {
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.35;
    margin: 0 0 var(--sp-2) 0;
  }

  .blog-showcase-card-title a {
    color: var(--gray-900);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-showcase-card:hover .blog-showcase-card-title a {
    color: var(--blue-600);
  }

  .blog-showcase-card-desc {
    font-size: var(--text-sm);
    color: var(--gray-600);
    line-height: 1.6;
    margin: 0 0 var(--sp-4) 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-showcase-card-footer {
    margin-top: auto;
    padding-top: var(--sp-3);
    border-top: 1px solid var(--gray-100);
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  .blog-showcase-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--blue-600);
    text-decoration: none;
    transition: all var(--dur) var(--ease);
    padding: var(--sp-1) 0;
  }

  .blog-showcase-btn:hover {
    color: var(--blue-800);
    text-decoration: none;
  }

  .blog-showcase-btn svg {
    transition: transform var(--dur) var(--ease);
  }

  .blog-showcase-card:hover .blog-showcase-btn svg,
  .blog-showcase-btn:hover svg {
    transform: translateX(4px);
  }

  .blog-showcase-mobile-cta {
    display: none;
    margin-top: var(--sp-8);
    text-align: center;
  }

  .blog-showcase-btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-2);
    width: 100%;
    padding: var(--sp-3) var(--sp-5);
    background: var(--blue-50);
    border: 1.5px solid var(--blue-200);
    border-radius: var(--radius-lg);
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--blue-700);
    text-decoration: none;
    transition: all var(--dur) var(--ease);
  }

  .blog-showcase-btn-secondary:hover {
    background: var(--blue-600);
    color: var(--white);
    border-color: var(--blue-600);
    text-decoration: none;
  }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .blog-showcase-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--sp-5);
    }
  }

  @media (max-width: 680px) {
    .blog-showcase-section {
      padding: var(--sp-10) var(--sp-4);
    }

    .blog-showcase-header {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--sp-3);
      margin-bottom: var(--sp-6);
    }

    .blog-showcase-viewall {
      display: none;
    }

    .blog-showcase-mobile-cta {
      display: block;
    }

    .blog-showcase-grid {
      grid-template-columns: 1fr;
      gap: var(--sp-4);
    }

    .blog-showcase-title {
      font-size: var(--text-2xl);
    }
  }
</style>
