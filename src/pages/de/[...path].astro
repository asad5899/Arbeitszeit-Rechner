---
import { getCollection } from 'astro:content';
import { tools } from '../../data/tools';

export async function getStaticPaths() {
  const paths = [];

  // 1. Core pages
  const corePaths = [
    '',
    'about',
    'contact',
    'faq',
    'blog',
    'authors',
    'categories',
    'tags',
    'archives',
    'privacy',
    'terms',
    'cookie-policy',
    'disclaimer',
    'accessibility',
    'editorial',
    'search'
  ];
  for (const p of corePaths) {
    paths.push({ params: { path: p || undefined } });
  }

  // 2. Tools
  for (const tool of tools) {
    paths.push({ params: { path: `tools/${tool.slug}` } });
  }

  // 3. Blog posts
  const posts = await getCollection('blog');
  for (const post of posts) {
    paths.push({ params: { path: `blog/${post.id}` } });
  }

  // 4. Authors
  const authors = await getCollection('authors');
  for (const author of authors) {
    paths.push({ params: { path: `authors/${author.id}` } });
    if (author.id === 'j-doe') {
      paths.push({ params: { path: 'authors/john-doe' } });
    }
    if (author.id === 'm-schmidt') {
      paths.push({ params: { path: 'authors/m.-schmidt' } });
    }
  }

  // 5. Categories (De/German ones, plus map others if requested)
  const dePosts = posts.filter(p => p.data.locale === 'de');
  const categories = [...new Set(dePosts.map(p => p.data.category))];
  for (const cat of categories) {
    const catSlug = cat.toLowerCase().replace(/\s+/g, '-');
    paths.push({ params: { path: `categories/${catSlug}` } });
  }

  // 6. Tags
  const tags = [...new Set(dePosts.flatMap(p => p.data.tags))];
  for (const tag of tags) {
    const tagSlug = tag.toLowerCase().replace(/\s+/g, '-');
    paths.push({ params: { path: `tags/${tagSlug}` } });
  }

  return paths;
}

const { path } = Astro.params;
const redirectTo = path ? `/${path}/` : '/';
const siteUrl = 'https://www.arbeitszeitrechnerpro.de';
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <title>Redirecting...</title>
    <meta http-equiv="refresh" content={`0;url=${redirectTo}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={`${siteUrl}${redirectTo}`} />
  </head>
  <body>
    Redirecting to <a href={redirectTo}>{redirectTo}</a>...
  </body>
</html>
