---
import { locales, defaultLocale, getLocaleFromUrl, useTranslations, getLocalizedPath } from '../../utils/i18n';
import SEO from '../../components/SEO.astro';
import Schema from '../../components/Schema.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import CookieConsent from '../../components/CookieConsent.astro';
import TrendingSidebar from '../../components/TrendingSidebar.astro';
import '../../styles/global.css';

export function getStaticPaths() {
  return [
    { params: { locale: undefined } },
    ...locales.filter(loc => loc !== defaultLocale).map(loc => ({
      params: { locale: loc }
    }))
  ];
}

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const title = locale === 'de' 
  ? 'Cookie-Richtlinie — Arbeitszeit Rechner Pro' 
  : locale === 'fr'
  ? 'Politique de Cookies — Calculateur Temps de Travail'
  : locale === 'ar'
  ? 'سياسة ملفات تعريف الارتباط — حاسبة ساعات العمل'
  : 'Cookie Policy — Work Time Calculator Pro';

const description = t('cookiePage.description');

const privacyPath = getLocalizedPath('/privacy', locale);
const contactPath = getLocalizedPath('/contact', locale);
const privacyLabel = t('nav.privacy');
const contactLabel = t('nav.contact');
---

<!DOCTYPE html>
<html lang={locale} dir={t('dir')}>
  <head>
    <meta charset="UTF-8" />
    <SEO title={title} description={description} locale={locale} robots={locale !== defaultLocale ? 'noindex, follow' : 'index, follow'} />
    <Schema type="webpage" title={title} description={description} />
  </head>
  <body>
    <Navbar />

    <main class="page">
      <h1 class="page-title">{t('nav.cookie')}</h1>
      
      <div class="main-grid" style="margin-top: var(--sp-6);">
        <div class="card" style="line-height: 1.8;">
          <!-- Section 1: What are cookies -->
          <h2 style="font-size: var(--text-xl); color: var(--blue-900); margin-bottom: var(--sp-4);">
            {t('cookiePage.whatTitle')}
          </h2>
          <p style="margin-bottom: var(--sp-4);">
            {t('cookiePage.whatText')}
          </p>

          <!-- Section 2: Types of cookies -->
          <h2 style="font-size: var(--text-xl); color: var(--blue-900); margin-top: var(--sp-6); margin-bottom: var(--sp-4);">
            {t('cookiePage.typesTitle')}
          </h2>
          <ul style="margin-left: var(--sp-6); margin-bottom: var(--sp-4);">
            <li>
              <strong>{t('cookiePage.essentialLabel')}</strong>{' '}
              {t('cookiePage.essentialText')}
            </li>
            <li>
              <strong>{t('cookiePage.analyticsLabel')}</strong>{' '}
              {t('cookiePage.analyticsText')}
            </li>
            <li>
              <strong>{t('cookiePage.marketingLabel')}</strong>{' '}
              {t('cookiePage.marketingText')}
            </li>
          </ul>

          <!-- Section 3: Revoking consent -->
          <h2 style="font-size: var(--text-xl); color: var(--blue-900); margin-top: var(--sp-6); margin-bottom: var(--sp-4);">
            {t('cookiePage.revokeTitle')}
          </h2>
          <p style="margin-bottom: var(--sp-4);">
            {t('cookiePage.revokeText')}
          </p>

          <!-- Section 4: Third-party services -->
          <h2 style="font-size: var(--text-xl); color: var(--blue-900); margin-top: var(--sp-6); margin-bottom: var(--sp-4);">
            {t('cookiePage.thirdPartyTitle')}
          </h2>
          <p style="margin-bottom: var(--sp-4);">
            {t('cookiePage.thirdPartyText')}{' '}
            <a href={privacyPath}>{privacyLabel}</a>.
          </p>

          <!-- Section 5: Contact -->
          <h2 style="font-size: var(--text-xl); color: var(--blue-900); margin-top: var(--sp-6); margin-bottom: var(--sp-4);">
            {t('cookiePage.contactTitle')}
          </h2>
          <p style="margin-bottom: var(--sp-4);">
            {t('cookiePage.contactText')}{' '}
            <a href={contactPath}>{contactLabel}</a>.
          </p>
        </div>
        <TrendingSidebar />
      </div>
    </main>

    <Footer />
    <CookieConsent />
  </body>
</html>
