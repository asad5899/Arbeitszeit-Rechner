---
import { getCollection } from 'astro:content';
import { locales, defaultLocale, getLocaleFromUrl, useTranslations, getLocalizedPath } from '../../../utils/i18n';
import SEO from '../../../components/SEO.astro';
import Schema from '../../../components/Schema.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import CookieConsent from '../../../components/CookieConsent.astro';
import TrendingSidebar from '../../../components/TrendingSidebar.astro';
import '../../../styles/global.css';

export function getStaticPaths() {
  return [
    { params: { locale: undefined } },
    ...locales.filter(loc => loc !== defaultLocale).map(loc => ({
      params: { locale: loc }
    }))
  ];
}

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

// Get blog posts matching current locale
const posts = await getCollection('blog', ({ data }) => {
  return data.locale === locale && !data.draft;
});

// Sort by date descending
posts.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

// Get unique categories and tags for listing
const categories = [...new Set(posts.map((p) => p.data.category))];
const tags = [...new Set(posts.flatMap((p) => p.data.tags))];

const title = locale === 'de' 
  ? 'Fachbeiträge & Ratgeber — Arbeitszeit Rechner Pro' 
  : locale === 'fr'
  ? 'Guides & Articles — Calculateur Temps de Travail'
  : locale === 'ar'
  ? 'المقالات والأدلة — حاسبة ساعات العمل'
  : 'Articles & Guides — Work Time Calculator Pro';
const description = 'Aktuelle Artikel zu Arbeitsrecht, Pausenregelungen, Zeiterfassung und Überstunden in Ihrem Land.';
---

<!DOCTYPE html>
<html lang={locale} dir={t('dir')}>
  <head>
    <meta charset="UTF-8" />
    <SEO title={title} description={description} locale={locale} />
    <Schema type="webpage" title={title} description={description} />
  </head>
  <body>
    <Navbar />

    <main class="page">
      <h1 class="page-title">{t('nav.blog')}</h1>
      <p class="page-subtitle">Aktuelle Leitfäden und Informationen unserer Fachredaktion.</p>

      <div class="main-grid">
        <!-- Main Listing -->
        <div style="display: flex; flex-direction: column; gap: var(--sp-6);">
          {posts.length === 0 ? (
            <p style="color: var(--gray-500);">Keine Beiträge gefunden.</p>
          ) : (
            posts.map((post) => (
              <article class="card blog-card" style="padding: var(--sp-6); display: flex; flex-direction: column; gap: var(--sp-4);">
                {post.data.image && (
                  <a href={getLocalizedPath(`/blog/${post.id}`, locale)} style="display: block; border-radius: var(--radius-md); overflow: hidden; aspect-ratio: 16/9; max-height: 240px; background: var(--gray-100);" aria-hidden="true" tabindex="-1">
                    <img 
                      src={post.data.image} 
                      alt={post.data.imageAlt || post.data.title}
                      loading="lazy"
                      decoding="async"
                      style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease;"
                      class="card-thumbnail"
                    />
                  </a>
                )}
                <div>
                  <div style="display: flex; gap: var(--sp-3); font-size: var(--text-xs); color: var(--blue-600); font-weight: 600; margin-bottom: var(--sp-2);">
                    <span>{post.data.category}</span>
                    <span>&bull;</span>
                    <span>{post.data.readingTime || '5 Min.'}</span>
                  </div>
                  <h2 style="font-size: var(--text-lg); font-weight: 700; color: var(--gray-900); margin: 0 0 var(--sp-2) 0; line-height: 1.35;">
                    <a href={getLocalizedPath(`/blog/${post.id}`, locale)} style="color: var(--gray-900); text-decoration: none;" class="post-title">
                      {post.data.title}
                    </a>
                  </h2>
                  <p style="font-size: var(--text-sm); color: var(--gray-600); line-height: 1.6; margin: 0;">
                    {post.data.description}
                  </p>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-top: auto; padding-top: var(--sp-2);">
                  <span style="font-size: var(--text-xs); color: var(--gray-500);">
                    {post.data.publishDate.toLocaleDateString(locale)}
                  </span>
                  <a href={getLocalizedPath(`/blog/${post.id}`, locale)} style="font-size: var(--text-sm); font-weight: 600; color: var(--blue-600); text-decoration: none; display: inline-flex; align-items: center; gap: 4px;" class="read-more-btn" aria-label={`${post.data.title} - ${t('blog.readMore')}`}>
                    <span>{t('blog.readMore') || 'Weiterlesen'}</span>
                    <span aria-hidden="true">&rarr;</span>
                  </a>
                </div>
              </article>
            ))
          )}
        </div>

        <!-- Sidebar with Categories and Tags -->
        <aside class="sidebar-column" aria-label="Blog Sidebar">
          <!-- Categories -->
          <div class="card" style="padding: var(--sp-5);">
            <h3 style="font-size: var(--text-sm); font-weight: 700; color: var(--gray-900); margin-bottom: var(--sp-4); text-transform: uppercase;">
              Kategorien
            </h3>
            <ul style="list-style: none; display: flex; flex-direction: column; gap: var(--sp-2);">
              {categories.map((cat) => (
                <li>
                  <a 
                    href={getLocalizedPath(`/categories/${cat.toLowerCase().replace(/\s+/g, '-')}`, locale)}
                    style="font-size: var(--text-sm); color: var(--gray-600); text-decoration: none;"
                    class="sidebar-link"
                  >
                    {cat}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <!-- Tags -->
          <div class="card" style="padding: var(--sp-5);">
            <h3 style="font-size: var(--text-sm); font-weight: 700; color: var(--gray-900); margin-bottom: var(--sp-4); text-transform: uppercase;">
              Schlagworte
            </h3>
            <div style="display: flex; flex-wrap: wrap; gap: var(--sp-2);">
              {tags.map((tag) => (
                <a 
                  href={getLocalizedPath(`/tags/${tag.toLowerCase().replace(/\s+/g, '-')}`, locale)}
                  style="font-size: var(--text-xs); background: var(--gray-200); color: var(--gray-700); padding: 4px var(--sp-2); border-radius: var(--radius-sm); text-decoration: none;"
                  class="tag-link"
                >
                  #{tag}
                </a>
              ))}
            </div>
          </div>

          <!-- Trending Tools Sidebar -->
          <TrendingSidebar />
        </aside>
      </div>
    </main>

    <Footer />
    <CookieConsent />
  </body>
</html>

<style>
  .blog-card {
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .blog-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }
  .blog-card:hover .card-thumbnail {
    transform: scale(1.03);
  }
  .post-title:hover {
    color: var(--blue-600) !important;
  }
  .read-more-btn:hover {
    color: var(--blue-700) !important;
    text-decoration: underline !important;
  }
  .sidebar-link:hover {
    color: var(--blue-600) !important;
    text-decoration: underline !important;
  }
  .tag-link:hover {
    background: var(--blue-100) !important;
    color: var(--blue-700) !important;
  }
</style>
